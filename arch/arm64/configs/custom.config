# Disable Samsung Securities
CONFIG_UH=n
CONFIG_UH_RKP=n
CONFIG_UH_LKMAUTH=n
CONFIG_UH_LKM_BLOCK=n
CONFIG_RKP_CFP_JOPP=n
CONFIG_RKP_CFP_ROPP=n
CONFIG_RKP_CFP=n
CONFIG_SECURITY_DEFEX=n
CONFIG_PROCA=n
CONFIG_FIVE=n

# Stock vendor modules are signed with Samsung's build-time key, which we do not
# have. Load them anyway (kernel gets tainted, nothing else changes).
CONFIG_MODULE_SIG_FORCE=n

# BakaSU (ReSukiSU)
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y

# USB gadget functions for USB Arsenal
# https://github.com/ravindu644/USB-Arsenal
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y

# NAT for tether
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
